---
/*
 * Deferred past the window `load` event on purpose — CLAUDE.md requires
 * analytics never delay first paint. Standard `async` alone still lets the
 * counter compete for bandwidth with fonts/images during initial render;
 * waiting for `load` (fires after every resource on the page has finished,
 * later than DOMContentLoaded) means the fetch of tag.js only starts once
 * there is nothing left to compete with. `readyState === 'complete'` covers
 * the rare case where `load` already fired before this script ran (e.g. a
 * fully cached repeat visit).
 */
import { yandexMetrikaId } from '@/data/analytics';
---

<script is:inline define:vars={{ counterId: yandexMetrikaId }}>
  function loadYandexMetrika() {
    (function (m, e, t, r, i, k, a) {
      m[i] =
        m[i] ||
        function () {
          (m[i].a = m[i].a || []).push(arguments);
        };
      m[i].l = 1 * new Date();
      for (var j = 0; j < document.scripts.length; j++) {
        if (document.scripts[j].src === r) return;
      }
      (k = e.createElement(t)),
        (a = e.getElementsByTagName(t)[0]),
        (k.async = 1),
        (k.src = r),
        a.parentNode.insertBefore(k, a);
    })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');

    window.ym(counterId, 'init', {
      clickmap: true,
      trackLinks: true,
      accurateTrackBounce: true,
    });
  }

  if (document.readyState === 'complete') {
    loadYandexMetrika();
  } else {
    window.addEventListener('load', loadYandexMetrika, { once: true });
  }
</script>
<noscript>
  <div><img src={`https://mc.yandex.ru/watch/${yandexMetrikaId}`} style="position:absolute; left:-9999px;" alt="" /></div>
</noscript>
