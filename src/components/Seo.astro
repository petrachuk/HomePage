---
/*
 * The complete SEO head for the two indexable content pages, `/en/` and
 * `/ru/`. Rendered via BaseLayout, so the root language stub never gets any
 * of it — `/` is not a content representation.
 *
 * Every URL resolves through src/i18n/routes.ts, so canonical, hreflang,
 * og:url, JSON-LD `url` and the sitemap cannot drift apart.
 */
import { useTranslations, type Locale } from '@/i18n/ui';
import { localePaths, absoluteUrl } from '@/i18n/routes';
import { ogImage, profileImages, profileDates } from '@/data/seo';
import { social } from '@/data/links';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const canonical = absoluteUrl(localePaths[locale]);
const ogImageUrl = absoluteUrl(ogImage.path);

/*
 * The same three alternates render on both pages: hreflang must be reciprocal
 * and self-referential. x-default points at /en/, never at `/`, because the
 * root is a redirect stub rather than a representation of the content.
 */
const alternates = [
  { hreflang: 'en', href: absoluteUrl(localePaths.en) },
  { hreflang: 'ru', href: absoluteUrl(localePaths.ru) },
  { hreflang: 'x-default', href: absoluteUrl(localePaths.en) },
];

const ogLocales: Record<Locale, string> = { en: 'en_US', ru: 'ru_RU' };
const otherLocale: Locale = locale === 'en' ? 'ru' : 'en';

/*
 * ProfilePage carries the page-level facts; Person carries identity only.
 * No jobTitle/worksFor/hasOccupation: the EN About and EN Experience job
 * titles disagree in the source content and that discrepancy is unresolved.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: canonical,
  inLanguage: locale,
  dateCreated: profileDates.created,
  dateModified: profileDates.modified,
  mainEntity: {
    '@type': 'Person',
    name: t.sidebar.name,
    description: t.sidebar.pitch,
    image: profileImages,
    // Derived from the one social-links source of truth, never retyped.
    sameAs: social.map((link) => link.url),
  },
};
---

<title>{t.meta.title}</title>
<meta name="description" content={t.meta.description} />

<link rel="canonical" href={canonical} />
{alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

<meta property="og:type" content="profile" />
<meta property="og:site_name" content={t.sidebar.name} />
<meta property="og:locale" content={ogLocales[locale]} />
<meta property="og:locale:alternate" content={ogLocales[otherLocale]} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={t.meta.title} />
<meta property="og:description" content={t.meta.description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content={String(ogImage.width)} />
<meta property="og:image:height" content={String(ogImage.height)} />
<meta property="og:image:type" content={ogImage.type} />
<meta property="og:image:alt" content={t.meta.ogImageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={t.meta.title} />
<meta name="twitter:description" content={t.meta.description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={t.meta.ogImageAlt} />

<link rel="icon" href="/favicon.ico" sizes="any" />

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
