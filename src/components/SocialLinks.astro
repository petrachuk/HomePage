---
import { Icon } from 'astro-icon/components';
import { social } from '@/data/links';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<ul class={`m-0 list-none p-0 ${className ?? ''}`}>
  {
    social.map((item) => (
      <li>
        <a
          href={item.url}
          target="_blank"
          rel="noopener"
          aria-label={item.label}
          class="text-text-secondary transition-colors duration-200 ease-out-quart hover:text-accent focus-visible:text-accent focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
        >
          <Icon name={item.icon} class="h-5 w-5" aria-hidden="true" />
        </a>
      </li>
    ))
  }
</ul>
