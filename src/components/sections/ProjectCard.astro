---
import { render, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import TagPill from '@/components/primitives/TagPill.astro';

export interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, repoUrl, tags } = entry.data;
const { Content } = await render(entry);
---

<li
  class="relative rounded-lg border border-transparent p-4 -m-4 transition-colors duration-200 ease-out-quart hover:border-border hover:bg-bg-elevated focus-within:border-border focus-within:bg-bg-elevated focus-within:ring-2 focus-within:ring-accent focus-within:ring-offset-2 focus-within:ring-offset-bg"
>
  <h3 class="text-base font-semibold text-text-primary">
    <a
      href={repoUrl}
      target="_blank"
      rel="noopener"
      class="static before:absolute before:inset-0 before:content-[''] hover:text-accent focus-visible:text-accent focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2"
      >{title}</a
    >
    <Icon
      name="simple-icons:github"
      aria-hidden="true"
      class="ml-1 inline-block h-4 w-4 text-text-secondary"
    />
  </h3>
  <div class="mt-2 space-y-2 text-sm text-text-secondary">
    <Content />
  </div>
  <div class="mt-3 flex flex-wrap gap-2">
    {tags.map((tag) => <TagPill label={tag} />)}
  </div>
</li>
