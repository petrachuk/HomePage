---
import '@/styles/global.css';
import Seo from '@/components/Seo.astro';
import YandexMetrika from '@/components/YandexMetrika.astro';
import type { Locale } from '@/i18n/ui';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo locale={locale} />
  </head>
  <body class="mx-auto max-w-6xl px-4 lg:px-8">
    <div class="lg:grid lg:grid-cols-[360px_1fr] lg:gap-16">
      <div class="lg:sticky lg:top-0 lg:self-start">
        <slot name="sidebar" />
      </div>
      <main class="lg:min-w-0">
        <slot />
      </main>
    </div>
    <YandexMetrika />
  </body>
</html>
